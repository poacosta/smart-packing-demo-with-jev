# Vercel AI Gateway key: Vercel dashboard → AI Gateway → API Keys.
# Not needed on Vercel, where the Gateway authenticates with OIDC.
# Without it (and without VERCEL_OIDC_TOKEN) the app uses an offline keyword fallback.
AI_GATEWAY_API_KEY=

# Optional: decision model used by experimental_decide (default: typesafe-ai/jev).
# For example, convaiinnovations/laya to compare with Laya.
# DECISION_MODEL=typesafe-ai/jev
